@{
    ViewData["Title"] = "Módulo de Categorías";
    var categorias = ViewBag.ListaCategorias as List<dynamic> ?? new List<dynamic>();
    var productos = ViewBag.ListaProductos as List<dynamic> ?? new List<dynamic>();
}

<div class="container mt-4">
    <!-- Encabezado -->
    <div class="p-3 my-3 text-white bg-dark rounded shadow-sm">
        <h4 class="mb-0 text-white"><i class="bi bi-tags-fill me-2"></i>Módulo de Categorías</h4>
        <small>Clasificación centralizada de Insumos - Terminal Agropecuario (Asoagro)</small>
    </div>

    <!-- Alertas TempData -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Formulario para Nueva Categoría -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white fw-bold">
                    <i class="bi bi-tag me-1"></i> Nueva Categoría de Insumos
                </div>
                <div class="card-body">
                    <form asp-action="CrearCategoria" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre de la Categoría</label>
                            <input type="text" name="nombreCategoria" class="form-control" placeholder="Ej: Fertilizantes, Semillas, Plaguicidas" required />
                        </div>
                        <button type="submit" class="btn btn-success fw-bold">
                            <i class="bi bi-plus-lg"></i> Registrar Categoría
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Lista de Categorías Registradas con Detalle de Productos y Stock -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-list-task me-1"></i> Categorías Registradas en el Servidor</span>
                    <span class="badge bg-light text-dark">@categorias.Count Categorías</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nombre de la Clasificación</th>
                                    <th class="text-center">Productos</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (categorias.Count > 0)
                                {
                                    int index = 0;
                                    foreach (var cat in categorias)
                                    {
                                        index++;
                                        string catNombre = Convert.ToString(cat.Nombre);
                                        int catId = Convert.ToInt32(cat.Id);

                                        // Filtrar productos utilizando únicamente CategoriaId (compatible con C# dynamic)
                                        var prodsCat = productos.Where(p => p.CategoriaId != null && p.CategoriaId == catId).ToList();

                                        <tr>
                                            <td>
                                                <button class="btn btn-link text-dark text-decoration-none p-0 fw-bold d-flex align-items-center gap-2" 
                                                        type="button" 
                                                        data-bs-toggle="collapse" 
                                                        data-bs-target="#collapseProds_@index">
                                                    <i class="bi bi-folder-fill text-warning fs-5"></i>
                                                    <span>@catNombre</span>
                                                    <i class="bi bi-chevron-down text-muted small ms-1"></i>
                                                </button>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-info text-dark">
                                                    @prodsCat.Count productos
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <form asp-action="EliminarCategoria" method="post" style="display:inline;" onsubmit="return confirm('¿Seguro que deseas eliminar esta categoría? Se eliminarán todos sus productos asociados.');">
                                                    <input type="hidden" name="id" value="@catId" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                                        <i class="bi bi-trash"></i> Eliminar
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        <!-- Fila colapsable con la lista de productos y stock -->
                                        <tr class="p-0 border-0">
                                            <td colspan="3" class="p-0 border-0">
                                                <div class="collapse bg-light p-3 border-top border-bottom" id="collapseProds_@index">
                                                    <h6 class="fw-bold text-secondary mb-2" style="font-size: 0.85rem;">
                                                        <i class="bi bi-box-seam me-1"></i> Productos en "@catNombre":
                                                    </h6>
                                                    @if (prodsCat.Count > 0)
                                                    {
                                                        <div class="table-responsive">
                                                            <table class="table table-sm table-bordered bg-white mb-0">
                                                                <thead class="table-light">
                                                                    <tr>
                                                                        <th>Producto</th>
                                                                        <th class="text-center">Stock Actual</th>
                                                                        <th class="text-end">Precio</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var p in prodsCat)
                                                                    {
                                                                        int stock = Convert.ToInt32(p.Stock);
                                                                        string badgeClass = stock > 10 ? "bg-success" : (stock > 0 ? "bg-warning text-dark" : "bg-danger");

                                                                        <tr>
                                                                            <td class="fw-semibold">@p.Nombre</td>
                                                                            <td class="text-center">
                                                                                <span class="badge @badgeClass">@stock un.</span>
                                                                            </td>
                                                                            <td class="text-end text-muted">$@Convert.ToDecimal(p.Precio).ToString("N0")</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <p class="text-muted small m-0"><em>No hay productos asignados a esta categoría.</em></p>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">
                                            No hay categorías registradas.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>