@{
    ViewData["Title"] = "Módulo de Ventas";
    var productos = ViewBag.ListaProductos as List<dynamic> ?? new List<dynamic>();
    var categorias = productos.Select(p => (string)p.Categoria).Distinct().ToList();
}

<div class="container mt-4" style="max-width: 650px;">
    
    @* Alertas TempData *@
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
            @if (TempData["GananciaObtenida"] != null)
            {
                <br /><strong>Total cobrado: $@TempData["GananciaObtenida"]</strong>
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <h4 class="mb-0"><i class="bi bi-cart-check-fill me-2"></i> Módulo de Ventas y Salidas</h4>
        </div>
        <div class="card-body p-4">
            
            <form asp-action="VenderProducto" method="post">

                <!-- Campo para ingresar Nombre del Cliente / Comprador -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Nombre del Cliente / Comprador</label>
                    <input type="text" name="nombreCliente" class="form-control form-control-lg" placeholder="Ej: Juan Pérez" required />
                </div>

                <!-- Selector de Categoría (Agregada opción TODAS para ver productos de múltiples categorías) -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Filtrar por Categoría</label>
                    <select id="selectCategoria" class="form-select form-select-lg" onchange="filtrarPorCategoria()">
                        <option value="TODAS" selected>📁 -- Mostrar categorías --</option>
                        @foreach (var cat in categorias)
                        {
                            <option value="@cat">📁 @cat</option>
                        }
                    </select>
                </div>
                
                <!-- Lista de Productos con Checkbox y Cantidad por producto -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Seleccionar Productos y Cantidad</label>
                    <div id="contenedorProductos" class="border rounded p-3 bg-light" style="max-height: 280px; overflow-y: auto;">
                        <p id="msgVacio" class="text-muted text-center m-0 d-none">-- No hay productos en esta categoría --</p>
                        
                        @foreach (var cat in categorias)
                        {
                            @foreach (var prod in productos.Where(p => p.Categoria == cat))
                            {
                                <!-- NOTA: Por defecto se muestran todos -->
                                <div class="item-producto d-flex mb-2 p-2 border rounded bg-white align-items-center justify-content-between" data-categoria="@prod.Categoria">
                                    <div class="form-check me-2">
                                        <input class="form-check-input chk-producto" type="checkbox" name="productoIds" value="@prod.Id" id="chk_@prod.Id" 
                                               data-precio="@prod.Precio" data-stock="@prod.Stock" onchange="toggleCantidad(this)" />
                                        <label class="form-check-label fw-semibold" for="chk_@prod.Id">
                                            @prod.Nombre <span class="badge bg-secondary ms-1" style="font-size: 0.7rem;">@prod.Categoria</span>
                                        </label>
                                        <div class="small text-muted">
                                            Stock: @prod.Stock | $@prod.Precio.ToString("N0")
                                        </div>
                                    </div>
                                    
                                    <div style="width: 110px;">
                                        <input type="number" name="cantidades" class="form-control input-cantidad" 
                                               min="1" max="@prod.Stock" value="1" placeholder="Cant." disabled oninput="actualizarCalculos()" />
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Total a Pagar Calculado Dinámicamente -->
                <div class="card bg-light border-0 mb-4">
                    <div class="card-body text-center py-3">
                        <span class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.85rem;">Total a Cobrar</span>
                        <h2 class="text-success fw-bolder mb-0">$<span id="lblTotal">0</span></h2>
                    </div>
                </div>

                <!-- Botón de Acción -->
                <button type="submit" id="btnProcesar" class="btn btn-primary btn-lg w-100 fw-bold" disabled>
                    <i class="bi bi-currency-dollar"></i> Procesar Venta y Restar Stock
                </button>
            </form>

        </div>
    </div>
</div>

<!-- Script adaptado para NO desmarcar productos seleccionados de otras categorías -->
<script>
    function filtrarPorCategoria() {
        const catSeleccionada = document.getElementById('selectCategoria').value;
        const msgVacio = document.getElementById('msgVacio');
        const items = document.querySelectorAll('.item-producto');

        let hayVisibles = false;

        items.forEach(item => {
            const categoriaItem = item.getAttribute('data-categoria');
            const chk = item.querySelector('.chk-producto');

            // Si es TODAS o coincide con la categoría seleccionada
            if (catSeleccionada === 'TODAS' || categoriaItem === catSeleccionada) {
                item.classList.remove('d-none');
                item.classList.add('d-flex');
                hayVisibles = true;
            } 
            // Si NO coincide pero el usuario YA HABÍA MARCADO el checkbox, lo dejamos visible para que no lo pierda
            else if (chk.checked) {
                item.classList.remove('d-none');
                item.classList.add('d-flex');
                hayVisibles = true;
            } 
            // Si no coincide y no está seleccionado, se oculta
            else {
                item.classList.add('d-none');
                item.classList.remove('d-flex');
            }
        });

        if (hayVisibles) {
            msgVacio.classList.add('d-none');
        } else {
            msgVacio.classList.remove('d-none');
        }

        actualizarCalculos();
    }

    function toggleCantidad(chk) {
        const item = chk.closest('.item-producto');
        const inputCantidad = item.querySelector('.input-cantidad');
        
        if (chk.checked) {
            inputCantidad.disabled = false;
            if (!inputCantidad.value || inputCantidad.value < 1) {
                inputCantidad.value = 1;
            }
        } else {
            inputCantidad.disabled = true;
        }

        actualizarCalculos();
    }

    function actualizarCalculos() {
        const checkboxes = document.querySelectorAll('.chk-producto:checked');
        const btnProcesar = document.getElementById('btnProcesar');
        const lblTotal = document.getElementById('lblTotal');
        
        let totalGeneral = 0;

        checkboxes.forEach(chk => {
            const item = chk.closest('.item-producto');
            const precio = parseFloat(chk.getAttribute('data-precio')) || 0;
            const inputCantidad = item.querySelector('.input-cantidad');
            const cantidad = parseInt(inputCantidad.value) || 0;

            totalGeneral += (precio * cantidad);
        });

        btnProcesar.disabled = (checkboxes.length === 0);
        lblTotal.textContent = totalGeneral.toLocaleString('es-CL');
    }
</script>